<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>SITB VIP PORTAL 2.0</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Poppins', 'Segoe UI', sans-serif;
        }

        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #080710;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            color: #fff;
        }

        /* Animated Glowing Background Circles - Fixed Centering */
        .background {
            width: 100vw;
            height: 100vh;
            position: absolute;
            top: 0;
            left: 0;
            overflow: hidden;
            z-index: 0;
            pointer-events: none;
        }

        .background .shape {
            height: 180px;
            width: 180px;
            position: absolute;
            border-radius: 50%;
            filter: blur(70px);
            animation: pulse 6s infinite alternate;
        }

        .shape:first-child {
            background: linear-gradient(#1845ad, #23a2f6);
            left: 10%;
            top: 20%;
        }

        .shape:last-child {
            background: linear-gradient(to right, #ff512f, #f09819);
            right: 10%;
            bottom: 20%;
            animation-delay: 3s;
        }

        @keyframes pulse {
            0% { transform: scale(1) translate(0, 0); }
            50% { transform: scale(1.2) translate(15px, -15px); }
            100% { transform: scale(0.9) translate(-15px, 15px); }
        }

        /* Particles Canvas BG */
        #bg-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        /* Glassmorphism Card Container - Fully Centered */
        .glass-card {
            position: relative;
            z-index: 2;
            width: 90%;
            max-width: 420px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 20px;
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 0 40px rgba(0, 0, 0, 0.6),
                        inset 0 0 15px rgba(255, 255, 255, 0.05);
            padding: 30px 20px;
            text-align: center;
            margin: auto;
        }

        .brand-title {
            font-size: 24px;
            font-weight: 800;
            letter-spacing: 2px;
            background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 5px;
            text-transform: uppercase;
        }

        .brand-subtitle {
            font-size: 12px;
            color: #a0a5b5;
            margin-bottom: 20px;
        }

        .step-container {
            display: none;
            animation: fadeIn 0.4s ease-in-out;
        }

        .step-container.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Input Styling */
        .input-group {
            position: relative;
            margin-bottom: 15px;
        }

        .input-group input {
            width: 100%;
            padding: 14px 14px 14px 45px;
            background: rgba(255, 255, 255, 0.07);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            color: #fff;
            font-size: 14px;
            outline: none;
            letter-spacing: 1px;
            transition: all 0.3s;
        }

        .input-group input:focus {
            border-color: #00f2fe;
            box-shadow: 0 0 15px rgba(0, 242, 254, 0.3);
            background: rgba(255, 255, 255, 0.12);
        }

        .input-group i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #00f2fe;
            font-size: 16px;
        }

        /* Buttons */
        .glow-btn {
            width: 100%;
            padding: 13px;
            border: none;
            border-radius: 12px;
            background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
            color: #000;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 0 20px rgba(0, 242, 254, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-transform: uppercase;
        }

        .glow-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 30px rgba(0, 242, 254, 0.7);
        }

        .glow-btn:disabled {
            background: rgba(255, 255, 255, 0.1);
            color: #6c757d;
            box-shadow: none;
            cursor: not-allowed;
            transform: none;
        }

        /* Telegram Channel Buttons */
        .tg-btn {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 12px 15px;
            border-radius: 12px;
            color: #fff;
            text-decoration: none;
            margin-bottom: 10px;
            transition: all 0.3s ease;
            font-size: 13px;
            font-weight: 500;
        }

        .tg-btn:hover {
            background: rgba(0, 136, 204, 0.2);
            border-color: #0088cc;
        }

        .tg-btn i {
            font-size: 16px;
            color: #0088cc;
        }

        .tg-btn.visited {
            border-color: #00ff87;
            background: rgba(0, 255, 135, 0.1);
        }

        .tg-btn.visited i {
            color: #00ff87;
        }

        .status-badge {
            font-size: 10px;
            padding: 4px 8px;
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.1);
            color: #aaa;
        }

        .tg-btn.visited .status-badge {
            background: #00ff87;
            color: #000;
            font-weight: 700;
        }

        .error-text {
            color: #ff4757;
            font-size: 12px;
            margin-bottom: 10px;
            display: none;
        }

        /* Download & Code Section Boxes */
        .section-box {
            background: rgba(0, 0, 0, 0.35);
            border: 1px dashed rgba(0, 242, 254, 0.4);
            border-radius: 12px;
            padding: 12px;
            margin-bottom: 15px;
            text-align: left;
        }

        .section-title {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #00f2fe;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 6px;
            font-weight: 600;
        }

        .file-info-inner {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }

        .file-icon {
            font-size: 24px;
            color: #00f2fe;
        }

        .file-details h4 {
            font-size: 12px;
            color: #fff;
            margin-bottom: 2px;
            word-break: break-all;
        }

        .file-details p {
            font-size: 10px;
            color: #00ff87;
        }

        /* One-Line Code Box */
        .code-input-wrap {
            position: relative;
            margin-bottom: 8px;
        }

        .code-input-wrap input {
            width: 100%;
            padding: 8px 10px;
            background: rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 6px;
            color: #7ee787;
            font-family: 'Courier New', Courier, monospace;
            font-size: 11px;
            outline: none;
            white-space: nowrap;
            overflow-x: auto;
        }
    </style>
</head>
<body>

    <!-- Background Animation Elements -->
    <canvas id="bg-canvas"></canvas>
    <div class="background">
        <div class="shape"></div>
        <div class="shape"></div>
    </div>

    <!-- Main Card Container -->
    <div class="glass-card">
        <h2 class="brand-title">SITB OFFICIAL</h2>
        <p class="brand-subtitle">SITB Auto Bot Activation Portal</p>

        <!-- STEP 1: KEY ACTIVATION -->
        <div id="step-1" class="step-container active">
            <div class="input-group">
                <i class="fa-solid fa-key"></i>
                <input type="text" id="activation-key" placeholder="Enter Activation Key...">
            </div>
            <div id="error-msg" class="error-text">
                <i class="fa-solid fa-triangle-exclamation"></i> Invalid Key! Try Again.
            </div>
            <button class="glow-btn" onclick="checkKey()">
                <span>Activate Access</span>
                <i class="fa-solid fa-arrow-right"></i>
            </button>
        </div>

        <!-- STEP 2: CHANNEL VERIFICATION -->
        <div id="step-2" class="step-container">
            <p style="font-size: 12px; color: #a0a5b5; margin-bottom: 12px;">Join all channels below to unlock your content:</p>
            
            <a href="https://t.me/sitbofficial" target="_blank" class="tg-btn" id="btn-ch1" onclick="visitChannel(1)">
                <span><i class="fa-brands fa-telegram"></i> SITB OFFICIAL</span>
                <span class="status-badge" id="badge-1">Visit</span>
            </a>

            <a href="https://t.me/stbpublic" target="_blank" class="tg-btn" id="btn-ch2" onclick="visitChannel(2)">
                <span><i class="fa-brands fa-telegram"></i> STB PUBLIC CHANEL</span>
                <span class="status-badge" id="badge-2">Visit</span>
            </a>

            <a href="https://t.me/sitbbotfree" target="_blank" class="tg-btn" id="btn-ch3" onclick="visitChannel(3)">
                <span><i class="fa-brands fa-telegram"></i> FREE BOT CHANNEL</span>
                <span class="status-badge" id="badge-3">Visit</span>
            </a>

            <button class="glow-btn" id="verify-btn" disabled onclick="verifyChannels()" style="margin-top: 10px;">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Verify Access</span>
            </button>
        </div>

        <!-- STEP 3: MAIN DASHBOARD WITH 2 BOXES -->
        <div id="step-3" class="step-container">
            
            <!-- BOX 1: FILE DOWNLOAD -->
            <div class="section-box">
                <div class="section-title">
                    <i class="fa-solid fa-file-arrow-down"></i> Text File Download
                </div>
                <div class="file-info-inner">
                    <i class="fa-solid fa-file-lines file-icon"></i>
                    <div class="file-details">
                        <h4>CRACKED BY SITB OFFICIAL 2.0.txt</h4>
                        <p><i class="fa-solid fa-circle-check"></i> Status: Ready</p>
                    </div>
                </div>
                <button class="glow-btn" onclick="downloadFile()" style="background: linear-gradient(135deg, #00ff87 0%, #60efff 100%); padding: 8px;">
                    <i class="fa-solid fa-download"></i>
                    <span>Download File</span>
                </button>
            </div>

            <!-- BOX 2: ONE-LINE SCRIPT & COPY BUTTON -->
            <div class="section-box">
                <div class="section-title">
                    <i class="fa-solid fa-code"></i> JavaScript Bookmarklet Code
                </div>
                <div class="code-input-wrap">
                    <input type="text" id="script-code-input" readonly>
                </div>
                <button class="glow-btn" id="copy-btn" onclick="copyCode()" style="background: linear-gradient(135deg, #ff007f 0%, #7928ca 100%); color: #fff; padding: 8px;">
                    <i class="fa-solid fa-copy"></i>
                    <span id="copy-btn-text">Copy Code</span>
                </button>
            </div>

        </div>
    </div>

<script>
    // --- CANVAS PARTICLES ANIMATION ---
    const canvas = document.getElementById('bg-canvas');
    const ctx = canvas.getContext('2d');
    
    function resizeCanvas() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
    }
    resizeCanvas();

    let particlesArray = [];
    class Particle {
        constructor() {
            this.x = Math.random() * canvas.width;
            this.y = Math.random() * canvas.height;
            this.size = Math.random() * 2 + 0.1;
            this.speedX = Math.random() * 0.8 - 0.4;
            this.speedY = Math.random() * 0.8 - 0.4;
            this.color = 'rgba(0, 242, 254, ' + (Math.random() * 0.5 + 0.2) + ')';
        }
        update() {
            this.x += this.speedX;
            this.y += this.speedY;
            if (this.x < 0 || this.x > canvas.width) this.speedX *= -1;
            if (this.y < 0 || this.y > canvas.height) this.speedY *= -1;
        }
        draw() {
            ctx.fillStyle = this.color;
            ctx.beginPath();
            ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
            ctx.fill();
        }
    }

    function init() {
        particlesArray = [];
        for (let i = 0; i < 50; i++) {
            particlesArray.push(new Particle());
        }
    }

    function animate() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        for (let i = 0; i < particlesArray.length; i++) {
            particlesArray[i].update();
            particlesArray[i].draw();
        }
        requestAnimationFrame(animate);
    }
    init();
    animate();

    window.addEventListener('resize', () => {
        resizeCanvas();
        init();
    });

    // --- ACTIVATION & VERIFICATION LOGIC ---
    const CORRECT_KEY = "SITB-A8F3-K9LX-27QM";
    let visitedChannels = { 1: false, 2: false, 3: false };

    // ফাইল কন্টেন্ট
    const fileContent = `javascript:(function(){if(document.getElementById('custom-trade-wrap'))return;const l="https://i.postimg.cc/76mrK7B5/IMG-20260825-215652-178.jpg";let t=null;const s=document.createElement('style');s.innerHTML=\`#custom-trade-wrap{position:fixed;bottom:30px;right:30px;z-index:999999;display:flex;flex-direction:column;align-items:center;touch-action:none;}#btn-box{position:relative;display:inline-block;}#c-btn{width:85px;height:85px;border-radius:50%;background:#1e222d url('\${l}') center/cover;border:3px solid #00e5ff;box-shadow:0 4px 15px rgba(0,0,0,.5);cursor:pointer;touch-action:none;}#cls{position:absolute;top:-5px;right:-5px;width:22px;height:22px;background:#ff3366;color:#fff;border-radius:50%;text-align:center;font-weight:bold;font-size:13px;cursor:pointer;line-height:20px;box-shadow:0 2px 6px rgba(0,0,0,.4);z-index:10;user-select:none;}#cls:hover{background:#ff0033;}#lbl{margin-top:6px;color:#00e5ff;font-size:11px;font-weight:900;text-shadow:0 0 6px #00e5ff;pointer-events:none;text-align:center;}#t-modal{position:fixed;background:#1e222d;border:1px solid #00e5ff;padding:15px;border-radius:12px;z-index:999999;display:flex;flex-direction:column;gap:8px;}#t-modal button{background:#2a2e39;color:#fff;border:1px solid #444;padding:8px 15px;border-radius:6px;cursor:pointer;font-weight:bold;}#t-modal button:hover{background:#00e5ff;color:#000;}#scan{position:fixed;top:0;left:0;width:100vw;height:4px;background:linear-gradient(90deg,transparent,#00ff66,#00e5ff,transparent);z-index:999998;display:none;animation:sc 1s infinite;}@keyframes sc{0%{top:10%;}50%{top:90%;}100%{top:10%;}}\`;document.head.appendChild(s);const scn=document.createElement('div');scn.id='scan';document.body.appendChild(scn);const wrap=document.createElement('div');wrap.id='custom-trade-wrap';document.body.appendChild(wrap);const bBox=document.createElement('div');bBox.id='btn-box';wrap.appendChild(bBox);const cls=document.createElement('div');cls.id='cls';cls.innerText='×';bBox.appendChild(cls);const btn=document.createElement('div');btn.id='c-btn';bBox.appendChild(btn);const lbl=document.createElement('div');lbl.id='lbl';lbl.innerText='SITB AUTO BOT';wrap.appendChild(lbl);cls.onclick=(e)=>{e.stopPropagation();wrap.remove();scn.remove();s.remove();const m=document.getElementById('t-modal');if(m)m.remove();};let isDrag=false,startX,startY,initX,initY;const startD=(x,y)=>{isDrag=false;startX=x;startY=y;initX=wrap.offsetLeft;initY=wrap.offsetTop;};const moveD=(x,y)=>{if(Math.abs(x-startX)>5||Math.abs(y-startY)>5)isDrag=true;wrap.style.left=(initX+x-startX)+'px';wrap.style.top=(initY+y-startY)+'px';wrap.style.bottom='auto';wrap.style.right='auto';};btn.addEventListener('mousedown',e=>{startD(e.clientX,e.clientY);const onMove=e=>moveD(e.clientX,e.clientY);const onUp=()=>{document.removeEventListener('mousemove',onMove);document.removeEventListener('mouseup',onUp);};document.addEventListener('mousemove',onMove);document.addEventListener('mouseup',onUp);});btn.addEventListener('touchstart',e=>{const t=e.touches[0];startD(t.clientX,t.clientY);const onMove=e=>{const t=e.touches[0];moveD(t.clientX,t.clientY);};const onEnd=()=>{document.removeEventListener('touchmove',onEnd);document.removeEventListener('touchend',onEnd);};document.addEventListener('touchmove',onMove);document.addEventListener('touchend',onEnd);});btn.addEventListener('click',()=>{if(isDrag)return;if(!t){if(document.getElementById('t-modal'))return;const m=document.createElement('div');m.id='t-modal';const r=btn.getBoundingClientRect();m.style.top=(r.top-140)+'px';m.style.left=r.left+'px';[5,10,15,30,60].forEach(sec=>{const sb=document.createElement('button');sb.innerText=sec>=60?\`\${sec/60} Min\`:\`\${sec} Sec\`;sb.onclick=()=>{t=sec;m.remove();};m.appendChild(sb);});document.body.appendChild(m);}else{scn.style.display='block';setTimeout(()=>{scn.style.display='none';let cBtn=null,pBtn=null;Array.from(document.querySelectorAll('button, div, a')).forEach(b=>{const txt=b.innerText?b.innerText.trim().toLowerCase():'';if(txt==='buy'||txt.startsWith('buy\\n'))cBtn=b;if(txt==='sell'||txt.startsWith('sell\\n'))pBtn=b;});const isCall=Math.random()>0.5;const target=isCall?cBtn:pBtn;if(target){const opts={bubbles:true,cancelable:true,view:window};target.dispatchEvent(new PointerEvent('pointerdown',opts));target.dispatchEvent(new MouseEvent('mousedown',opts));target.dispatchEvent(new PointerEvent('pointerup',opts));target.dispatchEvent(new MouseEvent('mouseup',opts));target.click();}else{alert(\`Signal: \${isCall?'CALL':'PUT'}\`);}},2500);}});})();`;

    document.getElementById('script-code-input').value = fileContent;

    function checkKey() {
        const inputKey = document.getElementById('activation-key').value.trim();
        const errorMsg = document.getElementById('error-msg');

        if (inputKey === CORRECT_KEY) {
            errorMsg.style.display = 'none';
            document.getElementById('step-1').classList.remove('active');
            document.getElementById('step-2').classList.add('active');
        } else {
            errorMsg.style.display = 'block';
        }
    }

    function visitChannel(channelNum) {
        visitedChannels[channelNum] = true;
        const btn = document.getElementById(`btn-ch${channelNum}`);
        const badge = document.getElementById(`badge-${channelNum}`);
        
        btn.classList.add('visited');
        badge.innerHTML = '<i class="fa-solid fa-check"></i> Visited';

        checkAllVisited();
    }

    function checkAllVisited() {
        if (visitedChannels[1] && visitedChannels[2] && visitedChannels[3]) {
            document.getElementById('verify-btn').disabled = false;
        }
    }

    function verifyChannels() {
        document.getElementById('step-2').classList.remove('active');
        document.getElementById('step-3').classList.add('active');
    }

    function downloadFile() {
        const blob = new Blob([fileContent], { type: 'text/plain' });
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'CRACKED BY SITB OFFICIAL 2.0.txt';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    function copyCode() {
        const codeInput = document.getElementById('script-code-input');
        codeInput.select();
        codeInput.setSelectionRange(0, 99999);

        navigator.clipboard.writeText(codeInput.value).then(() => {
            const btnText = document.getElementById('copy-btn-text');
            btnText.innerText = "Copied!";
            setTimeout(() => {
                btnText.innerText = "Copy Code";
            }, 2000);
        }).catch(err => {
            alert("Copy failed: " + err);
        });
    }
</script>
</body>
</html>
